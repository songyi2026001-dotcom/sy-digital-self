---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---
<BaseLayout title="Collections">
  <div class="eyebrow">04 / Collections</div>
  <h1 class="display" style="margin:22px 0 28px;">Collections</h1>
  <p class="lead">Things I've collected because they became part of me.</p>
  <section class="section grid">
    <a class="card" href="#"><span class="mono">01</span><h2>Music</h2><p>Songs, albums, sounds.</p></a>
    <a class="card" href="#"><span class="mono">02</span><h2>Books</h2><p>Books and passages that stayed.</p></a>
    <a class="card" href="#"><span class="mono">03</span><h2>Images</h2><p>Visual things worth keeping.</p></a>
    <a class="card" href="#"><span class="mono">04</span><h2>Places</h2><p>Cities, streets, rooms, landscapes.</p></a>
  </section>
</BaseLayout>
